# Aquatic Abyss default app choices.
#
# Do NOT edit this file — it ships with the repo. To override, copy it to
# ~/.config/aquatic-abyss/config.env and change values there.
#
# Format: KEY="value", one per line. This file is sourced by bash and parsed
# line-by-line by hyprland.lua, so keep it to plain assignments (no exports,
# no logic, no multi-line values).

# Desktop backend implementing the generic shell actions (launcher,
# notifications, control centre, wallpaper, OSD, lock, session UI) behind the
# scripts/aa/ wrapper commands. "noctalia" = Noctalia/Quickshell (default),
# "classic" = Waybar/wofi/swaync/AGS stack (deprecated but complete).
AA_BACKEND="noctalia"

AA_TERMINAL="kitty"
AA_BROWSER="chromium --disable-vulkan --ozone-platform=wayland"
AA_FILE_MANAGER="nautilus"
AA_MENU="wofi --show drun"
AA_IDE="vscodium"
AA_UPDATE_CMD="cachy-update"
