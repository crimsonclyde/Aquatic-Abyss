# Copy to ~/.config/aquatic-abyss/bt-soundbar.env and fill in your device.
# The module stays hidden from menus until BT_SOUNDBAR_MAC is set.

# Bluetooth address of the paired device. Find it with: bluetoothctl devices
BT_SOUNDBAR_MAC=""

# Friendly name used in notifications.
BT_SOUNDBAR_NAME="Soundbar"
