# Copy to ~/.config/aquatic-abyss/vpn-tailscale.env and fill in local values.
# (The legacy location ~/.config/hypr/vpn_menu.env is still read as a fallback.)

TS_PRIMARY_ID=""
TS_PRIMARY_NAME="Personal"
TS_SECONDARY_ID=""
TS_SECONDARY_NAME="Work"

# Optional friendly label for one NetworkManager OpenVPN profile.
# Other NetworkManager OpenVPN and WireGuard profiles are discovered automatically.
VPN_PRIMARY_NAME=""
VPN_PRIMARY_LABEL="OpenVPN"
