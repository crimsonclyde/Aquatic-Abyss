#!/usr/bin/env bash
# aa-notify — send and manage notifications (backend interface).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/backend.sh
. "$SCRIPT_DIR/../lib/backend.sh"

usage() {
    echo "Usage: $0 send <notify-send args...> | panel | dnd" >&2
    exit 2
}

backend_classic() {
    case "${1:-}" in
        send)
            shift
            exec notify-send "$@"
            ;;
        panel)
            exec swaync-client -t -sw
            ;;
        dnd)
            exec swaync-client -d -sw
            ;;
        *)
            usage
            ;;
    esac
}

backend_noctalia() {
    case "${1:-}" in
        send)
            # Noctalia's notification daemon receives standard notifications.
            shift
            notify-send "$@"
            ;;
        panel)
            noctalia msg panel-toggle control-center notifications
            ;;
        dnd)
            noctalia msg notification-dnd-toggle
            ;;
        *)
            usage
            ;;
    esac
}

aa_dispatch "$@"
