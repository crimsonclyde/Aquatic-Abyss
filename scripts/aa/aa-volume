#!/usr/bin/env bash
# aa-volume — volume/microphone keys with OSD (backend interface).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/backend.sh
. "$SCRIPT_DIR/../lib/backend.sh"

usage() {
    echo "Usage: $0 up|down|mute|mic-up|mic-down|mic-mute" >&2
    exit 2
}

backend_classic() {
    case "${1:-}" in
        up)       exec "$REPO/scripts/osd.sh" volume-up ;;
        down)     exec "$REPO/scripts/osd.sh" volume-down ;;
        mute)     exec "$REPO/scripts/osd.sh" volume-mute ;;
        mic-up)   exec "$REPO/scripts/osd.sh" mic-up ;;
        mic-down) exec "$REPO/scripts/osd.sh" mic-down ;;
        mic-mute) exec "$REPO/scripts/osd.sh" mic-mute ;;
        *)        usage ;;
    esac
}

backend_noctalia() {
    case "${1:-}" in
        up)       noctalia msg volume-up ;;
        down)     noctalia msg volume-down ;;
        mute)     noctalia msg volume-mute ;;
        mic-up)   noctalia msg mic-volume-up ;;
        mic-down) noctalia msg mic-volume-down ;;
        mic-mute) noctalia msg mic-mute ;;
        *)        usage ;;
    esac
}

aa_dispatch "$@"
